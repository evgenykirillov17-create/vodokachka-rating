rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /ratingApp/{document} {
      // Читать рейтинг может кто угодно.
      allow read: if true;

      // Записывать — только аккаунт админа, вошедший через Firebase Authentication.
      allow write: if request.auth != null
                   && request.auth.token.email == "admin@vodokachka.app";
    }
  }
}
