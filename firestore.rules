rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /ratingApp/{document} {
      // Публичное чтение — рейтинг видят все, без входа в систему.
      allow read: if true;

      // Запись открыта так же, как сейчас в артефакте: доступ в админку защищён
      // кодом на стороне интерфейса ("Админка" + пароль), а не серверной проверкой.
      // Это тот же уровень защиты, что уже был — не хуже и не лучше.
      allow write: if true;
    }
  }
}
